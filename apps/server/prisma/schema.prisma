generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum PlayerKind {
  HUMAN
  BOT
}

enum BotProfile {
  TAG
  LOOSE_PASSIVE
  MANIAC
  GTO
}

enum TableStatus {
  WAITING
  IN_HAND
  PAUSED
  CLOSED
}

enum SeatStatus {
  EMPTY
  OCCUPIED
  SIT_OUT
}

enum HandPhase {
  WAITING
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  COMPLETE
}

enum PokerAction {
  POST_SB
  POST_BB
  POST_DEAD
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALL_IN
  TIMEOUT_FOLD
  TIMEOUT_CHECK
}

model User {
  id           String      @id @default(cuid())
  email        String?     @unique
  username     String      @unique
  passwordHash String?
  isGuest      Boolean     @default(false)
  role         UserRole    @default(PLAYER)
  kind         PlayerKind  @default(HUMAN)
  botProfile   BotProfile?
  /// Play-money chips. Stays a 32-bit Int (Prisma BigInt becomes a TS bigint
  /// and breaks JSON across the server and shared packages). Migration
  /// 20261010120000_runtime_hardening caps it, and the other chip columns,
  /// safely below 2^31.
  bankroll     Int         @default(10000)
  avatarHue    Int         @default(210)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastSeenAt   DateTime?
  /// Auth hardening (migration 20261001100000_auth_hardening).
  /// lower(username), a STORED generated column: usernames are unique
  /// case-insensitively and every lookup/login goes through this column. The
  /// database computes it, so no writer can ever store a mismatching value;
  /// the application never writes it.
  usernameCanonical String    @unique @default(dbgenerated("lower(username)"))
  /// Consecutive failed password logins (reset on success) and the per-account
  /// lockout they trigger, independent of the client IP.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// Terms version accepted at sign-up and when; when 18+ was confirmed.
  termsVersion      String?
  termsAcceptedAt   DateTime?
  ageConfirmedAt    DateTime?
  /// Account security (migration 20261019100000_account_security).
  /// When the current email was proven (verify link, reset link or email-change confirm).
  emailVerifiedAt       DateTime?
  /// Bumped on password change or reset, lockdown and second-factor changes: older
  /// MFA tickets, reset links and email-change links stop working.
  credentialsVersion    Int       @default(0)
  passwordChangedAt     DateTime?
  /// Set by "this wasn't me": password sign-in is refused until a reset completes.
  passwordResetRequired Boolean   @default(false)
  /// Consecutive failed second-factor codes and the account-wide lock they trigger.
  mfaFailedCount        Int       @default(0)
  mfaLockedUntil        DateTime?
  /// Withdrawals and payout-destination changes are refused until this instant.
  securityHoldUntil     DateTime?
  /// WebAuthn user handle: base64url of 32 random bytes (never the id). Null until the first passkey.
  webauthnUserId        String?   @unique

  sessions    Session[]
  seats       TableSeat[]
  hostedTables Table[]      @relation("TableHost")
  handPlayers HandPlayer[]
  botStats    BotStatistic?
  /// Money ledger (migration 20261002200000_ledger_foundation).
  ledgerAccounts LedgerAccount[]
  /// Account security (migration 20261019100000_account_security).
  totp                  UserTotp?
  backupCodes           UserBackupCode[]
  passkeys              WebAuthnCredential[]
  emailTokens           EmailToken[]
  knownDevices          KnownDevice[]
  securityEvents        AccountSecurityEvent[]
  stepUpGrants          StepUpGrant[]
  stepUpEmailChallenges StepUpEmailChallenge[]
  /// Real-money wallet (migration 20261019120000_payments_wallet).
  compliance            PlayerCompliance?
  rgLimits              ResponsibleGamingLimit[]
  selfExclusions        SelfExclusion[]
  paymentInstruments    PaymentInstrument[]
  deposits              Deposit[]
  depositReversals      DepositReversal[]
  withdrawalQuotes      WithdrawalQuote[]
  withdrawals           Withdrawal[]
  payoutDispatches      PayoutDispatch[]
  reviewsAsSubject      PaymentReviewAction[] @relation("PaymentReviewSubjectUser")
  reviewsAsActor        PaymentReviewAction[] @relation("PaymentReviewActor")
  emailOutbox           EmailOutbox[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the CURRENT refresh token.
  refreshToken String   @unique
  /// min(last refresh + idle TTL, absoluteExpiresAt): the cookie, this row and
  /// the refresh JWT all expire at this instant.
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ip           String?
  /// Auth hardening (migration 20261001100000_auth_hardening).
  lastUsedAt        DateTime  @default(now())
  /// Hard end of the session however often it is refreshed.
  absoluteExpiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)"))
  /// SHA-256 of the token replaced by the last rotation, and when: presenting
  /// it within the grace window is an honest concurrent refresh; later, reuse.
  previousTokenHash String?
  rotatedAt         DateTime?
  /// Revoked sessions are kept (audit trail); a revoked row never authenticates.
  revokedAt         DateTime?
  revokeReason      String?
  /// Account security (migration 20261019100000_account_security).
  /// The browser (poker_device cookie) this session signed in from.
  deviceId          String?
  device            KnownDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// false: browser-session cookie, 12 h idle, 24 h absolute ("keep me signed in" off).
  persistent        Boolean   @default(true)
  /// How this session signed in: a subset of pwd, otp, backup, passkey.
  authMethods       String[]  @default([])
  /// Last step-up (a sign-in counts) and the methods it used: the 5-minute
  /// window for account changes. Money actions use StepUpGrant instead.
  reauthAt          DateTime?
  reauthMethods     String[]  @default([])

  stepUpGrants          StepUpGrant[]
  stepUpEmailChallenges StepUpEmailChallenge[]

  @@index([userId])
  /// Expiry sweeps and "is this session still live" lookups.
  @@index([expiresAt])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Account security (migration 20261019100000_account_security).
// RLS is forced on every table. The runtime role gets column-level UPDATE
// grants only, so it can never rewrite a stored TOTP secret, passkey public
// key, token hash or code hash (delete-then-insert is the only replacement),
// and it can mint a StepUpGrant but never consume, change or delete one.
// Not expressible here (declared in the migration): the CHECKs, the
// append-only trigger on AccountSecurityEvent and the single-use trigger on
// StepUpGrant.
// ---------------------------------------------------------------------------

enum EmailTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  EMAIL_CHANGE
  SECURITY_LOCKDOWN
}

/// A browser that signed in to this account (poker_device cookie, stored hashed).
model KnownDevice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the poker_device cookie value.
  deviceHash  String
  /// "<Browser> on <OS>", from the user agent.
  label       String?
  userAgent   String?
  /// Coarse network only (/24 or /48).
  lastIp      String?
  country     String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  sessions Session[]

  @@unique([userId, deviceHash])
}

/// One TOTP authenticator. Pending until enabledAt; disabledAt keeps it restorable by lockdown.
model UserTotp {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM v2 ciphertext under AUTH_ENCRYPTION_KEYS, context "user-totp:<userId>".
  secretCiphertext String
  enabledAt        DateTime?
  disabledAt       DateTime?
  /// Highest accepted 30 s step. A code for this step or an older one is refused.
  lastUsedStep     Int       @default(0)
  createdAt        DateTime  @default(now())
}

model UserBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC-SHA256 hex (AUTH_HMAC_SECRET subkey "backup-code") of userId + ":" + normalized code.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url credential id.
  credentialId String    @unique
  /// base64url COSE public key.
  publicKey    String
  /// uint32 signature counter. Never sent over JSON.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// singleDevice or multiDevice.
  deviceType   String
  backedUp     Boolean   @default(false)
  aaguid       String?
  /// The RP ID it was registered under; verification uses this one.
  rpId         String
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  /// Soft delete: lockdown restores a passkey removed after the incident.
  removedAt    DateTime?

  @@index([userId])
}

/// Email link tokens. Only the SHA-256 of the token is stored.
model EmailToken {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose            EmailTokenPurpose
  tokenHash          String            @unique
  /// Address the link was sent to (EMAIL_CHANGE: the new address).
  email              String
  credentialsVersion Int
  /// EMAIL_CHANGE: { previousEmail }. SECURITY_LOCKDOWN: { kind, incidentAt, sessionId?, revertEmail? }.
  /// PASSWORD_RESET issued by a lockdown: { issuedBy: "lockdown" }.
  data               Json              @default("{}")
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime          @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

/// Single-use marks for signed MFA tickets and WebAuthn challenge tokens (id = jti).
model AuthNonce {
  id        String   @id
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Append-only account security history (sign-ins, credential changes, lockdowns).
/// type is a SecurityEventType from @poker/shared. The payments review reads it
/// (RECENT_SECURITY_CHANGE_EVENT_TYPES, NOT_ME_REPORTED).
model AccountSecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type      String
  sessionId String?
  /// Coarse network only.
  ip        String?
  userAgent String?
  country   String?
  /// Never a token, code, password, link or full IP address.
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A single-use, transaction-bound step-up for one money action. The API
/// writes it after checking the proof; the payments Worker consumes it (sets
/// consumedAt) inside the transaction it authorises, matching userId,
/// sessionId, purpose and bindHash. The database refuses a second
/// consumption, any other change, a PASSWORD-only grant and an
/// admin_payments grant without a passkey.
model StepUpGrant {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The session that proved it; the grant is good for that session only.
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// withdrawal | payout_destination | admin_payments (StepUpPurpose).
  purpose    String
  /// Lower-case hex SHA-256 of the canonical JSON of the action, computed by payments.
  bindHash   String
  /// PASSKEY | TOTP | PASSWORD_EMAIL | PASSWORD (StepUpGrantMethod). TOTP covers a backup code.
  method     String
  /// No default: write createdAt and expiresAt from one clock reading
  /// (the database checks expiresAt <= createdAt + 5 minutes).
  createdAt  DateTime
  expiresAt  DateTime
  /// Set once, by the consumer, and never changed afterwards.
  consumedAt DateTime?

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([expiresAt])
}

/// The emailed code of a password + email step-up, offered only to users with
/// neither TOTP nor a passkey: 6 digits, 10 minutes, 5 tries, bound to one
/// session, purpose and bindHash. Only an HMAC of the code is stored.
model StepUpEmailChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// withdrawal | payout_destination (admin_payments needs a passkey).
  purpose    String
  bindHash   String
  /// HMAC-SHA256 hex (AUTH_HMAC_SECRET subkey "step-up-email-code") of id + ":" + code.
  codeHash   String
  /// Address the code was sent to; the proof fails if the account email changed since.
  email      String
  /// Wrong codes so far. At 5 the challenge is dead.
  attempts   Int       @default(0)
  /// No default: write createdAt and expiresAt from one clock reading
  /// (the database checks expiresAt <= createdAt + 10 minutes).
  createdAt  DateTime
  expiresAt  DateTime
  /// Set when the right code was used, or when the challenge was voided.
  consumedAt DateTime?

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([expiresAt])
}

model Table {
  id         String      @id @default(cuid())
  name       String
  hostId     String?
  host       User?       @relation("TableHost", fields: [hostId], references: [id])
  status     TableStatus @default(WAITING)
  maxSeats   Int         @default(6)
  smallBlind Int
  bigBlind   Int
  minBuyIn   Int
  maxBuyIn   Int
  timeBankMs Int         @default(15000)
  isPrivate  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  closedAt   DateTime?
  /// Set with status PAUSED when the server stops running the table after
  /// repeated failures (migration 20261003100000_game_reliability); see TableIncident.
  pausedAt     DateTime?
  pausedReason String?

  stateCiphertext String?

  seats TableSeat[]
  hands Hand[]
  /// Money ledger (migration 20261002200000_ledger_foundation).
  ledgerAccounts LedgerAccount[]
  incidents      TableIncident[]

  @@index([status])
  @@index([hostId])
  /// Lobby (GET /api/tables): public tables that are not CLOSED, newest first.
  /// Composite rather than partial: Prisma 6 cannot model a WHERE index, and
  /// migrate diff must match this file. (isPrivate, status, createdAt DESC)
  /// is the prefix of that filter and sort.
  @@index([isPrivate, status, createdAt(sort: Desc)])
}

/// An operator incident at a table (migration 20261003100000_game_reliability):
/// written when the server pauses a table it can no longer run. The runtime
/// role may insert and resolve incidents but never delete them.
model TableIncident {
  id         String    @id @default(cuid())
  tableId    String
  table      Table     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  /// What happened, e.g. TIMER_FAILURES.
  kind       String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([tableId, createdAt])
}

/// One committed table mutation (migration 20261010130000_game_command).
/// Inserted in the same Postgres transaction as the bankroll change. A unique
/// conflict means the mutation already committed. The runtime role may
/// SELECT and INSERT this table, never UPDATE or DELETE.
model GameCommand {
  id              String   @id
  tableId         String
  userId          String?
  kind            String
  appliedRevision Int
  createdAt       DateTime @default(now())

  @@index([tableId, createdAt])
}

model TableSeat {
  id         String      @id @default(cuid())
  tableId    String
  table      Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatIndex  Int
  userId     String?     @unique
  user       User?       @relation(fields: [userId], references: [id])
  playerKind PlayerKind  @default(HUMAN)
  botProfile BotProfile?
  stack      Int         @default(0)
  status     SeatStatus  @default(EMPTY)
  sittingOut Boolean     @default(false)
  joinedAt   DateTime    @default(now())

  @@unique([tableId, seatIndex])
}

model Hand {
  id         String    @id @default(cuid())
  tableId    String
  /// Deleting a table must not cascade-delete hand history (migration
  /// 20261010120000_runtime_hardening). Append-only triggers block UPDATE
  /// and DELETE unless poker.break_glass is on.
  table      Table     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  handNumber Int
  phase      HandPhase @default(COMPLETE)
  dealerSeat Int
  sbSeat     Int?
  bbSeat     Int?
  board      String[]
  potTotal   Int       @default(0)
  rake       Int       @default(0)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  snapshot   Json?
  fairnessRoot String?
  /// Legacy (pre-audit-trail) encrypted commitment; null for audited hands.
  fairnessAudit String?
  /// Compliance audit trail (migration 20260924120000_compliance_audit_trail).
  /// UUID v4 hand id from the engine; unique across all tables.
  handUuid       String? @unique @db.Uuid
  /// SHA-256 commitment to the shuffled deck, made before dealing.
  deckCommitment String?
  /// Post-hand verification hash over the whole hash-chained record.
  finalStateHash String?
  /// Public hash-chained HandAuditRecord (no hidden cards).
  auditRecord    Json?
  /// AES-256-GCM SealedHandAudit (deck order and salts); regulator only.
  auditSealed    String?

  players HandPlayer[]
  actions HandAction[]
  pots    HandPot[]

  @@unique([tableId, handNumber])
}

model HandPlayer {
  id            String      @id @default(cuid())
  handId        String
  hand          Hand        @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId        String?
  /// Deleting a user must not drop or null out their hand history.
  user          User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  seatIndex     Int
  playerKind    PlayerKind
  botProfile    BotProfile?
  holeCards     String[]
  encryptedHoleCards String?
  startingStack Int
  endingStack   Int
  net           Int
  showedCards   Boolean     @default(false)
  won           Boolean     @default(false)
  handRankName  String?
  handRankValue BigInt?

  @@unique([handId, seatIndex])
  @@index([userId])
}

model HandAction {
  id        String      @id @default(cuid())
  handId    String
  hand      Hand        @relation(fields: [handId], references: [id], onDelete: Cascade)
  seq       Int
  seatIndex Int
  street    HandPhase
  action    PokerAction
  amount    Int         @default(0)
  toAmount  Int?
  createdAt DateTime    @default(now())

  @@unique([handId, seq])
}

model HandPot {
  id             String @id @default(cuid())
  handId         String
  hand           Hand   @relation(fields: [handId], references: [id], onDelete: Cascade)
  potIndex       Int
  amount         Int
  eligibleSeats  Int[]
  winnerSeats    Int[]
  oddChipSeat    Int?

  @@unique([handId, potIndex])
}

model BotStatistic {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         BotProfile
  handsPlayed     Int        @default(0)
  vpipHands       Int        @default(0)
  pfrHands        Int        @default(0)
  aggressionBets  Int        @default(0)
  aggressionCalls Int        @default(0)
  showdowns       Int        @default(0)
  showdownsWon    Int        @default(0)
  chipsWon        Int        @default(0)
  updatedAt       DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Money ledger (migration 20261002200000_ledger_foundation, docs/money/LEDGER.md).
// The runtime role can only SELECT these tables; every write goes through the
// SECURITY DEFINER functions ledger_ensure_account / ledger_post, called with
// $queryRaw from src/money/ledger.ts. Never create/update these rows through
// the Prisma model API (it would be refused anyway).
// Not expressible here (declared in the migration): the owner uniqueness index
// over COALESCE(userId/tableId/providerKey, ''), the CHECKs, the append-only
// triggers and the ledger functions.
// ---------------------------------------------------------------------------

enum AssetKind {
  PLAY
  FIAT
  CRYPTO
  /// Sandbox money (TEST_EUR, migration 20261019110000_ledger_payment_types): only
  /// the sandbox provider's accounts and payment rows may hold it, and they hold nothing else.
  TEST
}

enum LedgerAccountType {
  USER_AVAILABLE
  USER_WITHDRAWAL_HOLD
  TABLE_ESCROW
  PLAY_ISSUANCE
  RAKE_REVENUE
  DEPOSIT_CLEARING
  WITHDRAWAL_CLEARING
  PROVIDER_FEES
  ADJUSTMENTS
  CHARGEBACK_LOSSES
}

enum LedgerTransactionType {
  PLAY_GRANT
  BUY_IN
  CASH_OUT
  RAKE
  DEPOSIT_CREDIT
  DEPOSIT_REVERSAL
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  WITHDRAWAL_SETTLE
  PROVIDER_FEE
  ADJUSTMENT
  /// Exact inverse of a DEPOSIT_REVERSAL after a won dispute (payments wallet).
  CHARGEBACK_RECOVERY
  /// A settled payout that the rail sent back (payments wallet).
  WITHDRAWAL_RETURN
}

model Asset {
  code          String    @id
  kind          AssetKind
  /// Precision of the ledger minor unit (PLAY 0, EUR 2, BTC 8, ETH 9 = gwei, stablecoins 6).
  decimals      Int       @db.SmallInt
  /// On-chain precision (ETH 18); null for PLAY and fiat.
  chainDecimals Int?      @db.SmallInt
  network       String?
  /// Real assets ship disabled; both ledger functions refuse a disabled asset.
  enabled       Boolean   @default(false)
  /// Largest magnitude of a single entry, in minor units.
  maxAmount     BigInt
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  accounts LedgerAccount[]
  /// Real-money wallet (migration 20261019120000_payments_wallet).
  rgLimits           ResponsibleGamingLimit[]
  paymentInstruments PaymentInstrument[]
  deposits           Deposit[]
  withdrawalQuotes   WithdrawalQuote[]
  withdrawals        Withdrawal[]
}

model LedgerAccount {
  id            BigInt            @id @default(autoincrement())
  assetCode     String
  asset         Asset             @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  type          LedgerAccountType
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tableId       String?
  table         Table?            @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerKey   String?
  /// Fixed by the type (PLAY_ISSUANCE, DEPOSIT_CLEARING, ADJUSTMENTS, CHARGEBACK_LOSSES).
  allowNegative Boolean           @default(false)
  /// Cached sum of this account's entries (minor units).
  balance       BigInt            @default(0)
  /// Number of entries ever posted; entries carry their 1-based accountVersion.
  version       BigInt            @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  entries LedgerEntry[]

  @@unique([id, assetCode])
  @@index([userId])
  @@index([tableId])
}

model LedgerTransaction {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Global posting order.
  seq            BigInt                @unique @default(autoincrement())
  /// Caller-supplied deterministic key; a replay with the same payload returns this row.
  idempotencyKey String                @unique
  type           LedgerTransactionType
  reference      Json                  @default("{}")
  /// SHA-256 of the canonical payload (type, reference, sorted entries).
  payloadHash    String
  createdBy      String?
  createdAt      DateTime              @default(now())

  entries LedgerEntry[]
  /// The payment row each payment-type transaction is bound to (deferred trigger LedgerTransaction_payment_binding).
  depositCredit     Deposit?         @relation("DepositCreditTx")
  depositReversal   DepositReversal? @relation("DepositReversalTx")
  withdrawalHold    Withdrawal?      @relation("WithdrawalHoldTx")
  withdrawalRelease Withdrawal?      @relation("WithdrawalReleaseTx")
  withdrawalSettle  Withdrawal?      @relation("WithdrawalSettleTx")
  withdrawalReturn  Withdrawal?      @relation("WithdrawalReturnTx")
}

model LedgerEntry {
  id             BigInt            @id @default(autoincrement())
  transactionId  String            @db.Uuid
  transaction    LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId      BigInt
  /// Always the account's asset (composite foreign key).
  assetCode      String
  account        LedgerAccount     @relation(fields: [accountId, assetCode], references: [id, assetCode], onDelete: Restrict, onUpdate: Restrict)
  /// Signed, non-zero, minor units.
  amount         BigInt
  balanceAfter   BigInt
  accountVersion BigInt
  createdAt      DateTime          @default(now())

  @@unique([accountId, accountVersion])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Real-money wallet (migrations 20261019110000_ledger_payment_types and
// 20261019120000_payments_wallet, docs/money/WALLET.md). Written by the
// payments Worker (database role poker_payments, login poker_payments_app);
// the API Worker (poker_server) only inserts ResponsibleGamingLimit and
// SelfExclusion rows and reads PlayerCompliance and PaymentSwitch. Not
// expressible here (declared in the migration): the CHECKs, the state-machine,
// append-only, step-up and sandbox-isolation triggers, the deferred
// payment-binding constraint trigger on LedgerTransaction and the ledger entry
// points ledger_post / ledger_post_payments / ledger_post_backoffice. Every
// trigger sets createdAt (and updatedAt) from the database clock. Amount
// columns are minor units of assetCode (EUR or the sandbox TEST_EUR, 2
// decimals); never JSON-serialise these models directly (BigInt).
// ---------------------------------------------------------------------------

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ScreeningStatus {
  NOT_SCREENED
  CLEAR
  POTENTIAL_MATCH
  CONFIRMED_MATCH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SourceOfFundsStatus {
  NOT_REQUIRED
  REQUESTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentsRestriction {
  NONE
  DEPOSITS_BLOCKED
  WITHDRAWALS_MANUAL
  FROZEN
}

enum RgLimitKind {
  DEPOSIT
}

enum RgLimitPeriod {
  DAY
  WEEK
  MONTH
}

enum RgSource {
  PLAYER
  OPERATOR
}

enum SelfExclusionKind {
  DEFINITE
  INDEFINITE
}

enum PaymentMethodKind {
  CARD
  CRYPTO
}

enum InstrumentKind {
  CARD_TOKEN
  CRYPTO_ADDRESS
}

enum InstrumentStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum InstrumentOrigin {
  DEPOSIT
  PLAYER
  OPERATOR
}

enum DepositStatus {
  CREATED
  PENDING
  CONFIRMED
  CREDITED
  NEEDS_REVIEW
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REVERSED
  REVERSED
}

enum DepositReversalKind {
  CHARGEBACK
  PROVIDER_REFUND
  CHAIN_REORG
  CHARGEBACK_RECOVERY
}

enum WithdrawalKind {
  PLAYER
  REFUND
}

enum WithdrawalStatus {
  REQUESTED
  HELD
  UNDER_REVIEW
  APPROVED
  SUBMITTED
  SETTLED
  FAILED
  REJECTED
  CANCELLED
  RETURNED
}

enum PayoutOperation {
  PAYOUT
  REFUND
}

enum PayoutDispatchStatus {
  PENDING
  IN_FLIGHT
  SENT
  UNCERTAIN
  RETRY_WAIT
  COMPLETED
  FAILED
  MANUAL
  CANCELLED
}

enum PayoutAttemptOutcome {
  ACCEPTED
  COMPLETED
  REJECTED_FINAL
  REJECTED_RETRYABLE
  UNCERTAIN
  NOT_FOUND
}

enum PaymentObjectType {
  PAYMENT
  PAYOUT
  REFUND
  DISPUTE
  KYC
}

enum PaymentEventOutcome {
  APPLIED
  DUPLICATE
  STALE
  UNKNOWN_OBJECT
  NEEDS_REVIEW
  DEAD
}

enum PaymentReviewSubject {
  DEPOSIT
  WITHDRAWAL
  INSTRUMENT
  USER
  SWITCH
}

enum PaymentReviewVerb {
  APPROVE
  REJECT
  NOTE
  RESTRICT
  UNRESTRICT
  RESOLVE
  SWITCH_ON
  SWITCH_OFF
}

enum ReconciliationStatus {
  RUNNING
  OK
  ISSUES
  FAILED
}

enum ReconciliationIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Per-user KYC/AML/payments state. Also the per-user lock row of every payments flow.
model PlayerCompliance {
  userId                   String              @id
  user                     User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kycStatus                KycStatus           @default(UNVERIFIED)
  kycProvider              String?
  kycApplicantRef          String?
  kycLevel                 String?
  kycSubmittedAt           DateTime?
  kycVerifiedAt            DateTime?
  kycRejectedAt            DateTime?
  kycRejectReason          String?
  kycReviewDueAt           DateTime?
  legalFirstName           String?
  legalLastName            String?
  birthDate                DateTime?           @db.Date
  residenceCountry         String?
  screeningStatus          ScreeningStatus     @default(NOT_SCREENED)
  screenedAt               DateTime?
  riskLevel                RiskLevel           @default(MEDIUM)
  sourceOfFundsStatus      SourceOfFundsStatus @default(NOT_REQUIRED)
  restriction              PaymentsRestriction @default(NONE)
  restrictionReason        String?
  restrictedAt             DateTime?
  restrictedBy             String?
  /// Set once the deposit-limit setup was shown (LIMITS_SETUP_REQUIRED before the first deposit).
  rgLimitsPromptedAt       DateTime?
  lifetimeDepositedMinor   BigInt              @default(0)
  firstDepositAt           DateTime?
  chargebackCount          Int                 @default(0)
  chargebackShortfallMinor BigInt              @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @default(now()) @updatedAt

  @@index([kycApplicantRef])
}

/// Append-only limit requests; the active limit is the newest uncancelled row with effectiveFrom <= now.
model ResponsibleGamingLimit {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind          RgLimitKind
  period        RgLimitPeriod
  assetCode     String        @default("EUR")
  asset         Asset         @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  /// Null = no limit (a removal; takes effect after 24 h).
  amountMinor   BigInt?
  source        RgSource      @default(PLAYER)
  createdBy     String
  requestedAt   DateTime      @default(now())
  /// Set by the database: now for a stricter limit, now + 24 h for a looser one or a removal.
  effectiveFrom DateTime      @default(now())
  /// Only a pending (not yet effective) change can be cancelled; a new request cancels it.
  cancelledAt   DateTime?

  @@index([userId, kind, period, effectiveFrom])
}

/// Active while startsAt <= now and (accessRestoredAt is null or in the future).
model SelfExclusion {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind                    SelfExclusionKind
  source                  RgSource          @default(PLAYER)
  reason                  String?
  createdBy               String
  startsAt                DateTime          @default(now())
  /// Required for DEFINITE (at least 24 h after startsAt), null for INDEFINITE.
  endsAt                  DateTime?
  reactivationRequestedAt DateTime?
  reactivationAcceptedAt  DateTime?
  reactivationAcceptedBy  String?
  /// Set by the database: request + 24 h (DEFINITE, no operator needed), acceptance + 7 days (INDEFINITE).
  accessRestoredAt        DateTime?
  createdAt               DateTime          @default(now())

  @@index([userId, startsAt])
}

/// A PSP card token (deposits and payouts) or a crypto payout address. For a
/// card, assetCode is the ledger asset it settles in (EUR, or TEST_EUR with the
/// sandbox); for an address, the payout rail (BTC, USDC_ERC20, ...).
model PaymentInstrument {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind                InstrumentKind
  status              InstrumentStatus  @default(ACTIVE)
  origin              InstrumentOrigin
  providerKey         String
  assetCode           String
  asset               Asset             @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  network             String?
  address             String?
  addressNormalized   String?
  memo                String?
  cardToken           String?
  cardFingerprint     String?
  cardBrand           String?
  cardLast4           String?
  cardExpMonth        Int?              @db.SmallInt
  cardExpYear         Int?              @db.SmallInt
  cardIssuerCountry   String?
  /// debit | credit | prepaid | unknown
  cardFunding         String?
  depositEnabled      Boolean           @default(false)
  payoutEnabled       Boolean           @default(false)
  label               String?
  createdBySessionId  String?
  /// The consumed payout_destination StepUpGrant (required for origin PLAYER; one instrument per grant).
  stepUpGrantId       String?           @unique
  ownershipMethod     String?
  ownershipProof      Json?
  ownershipVerifiedAt DateTime?
  /// Cooling-off end; the database enforces >= now + 24 h for every address the operator did not add.
  usableAfter         DateTime          @default(now())
  lastUsedAt          DateTime?
  successfulPayouts   Int               @default(0)
  revokedAt           DateTime?
  revokedReason       String?
  revokedBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  deposits         Deposit[]
  withdrawals      Withdrawal[]
  withdrawalQuotes WithdrawalQuote[]

  /// Not unique: a revoked row stays revoked and a fresh deposit with that card adds a new one. The instrument guard keeps one live row per user and card.
  @@index([providerKey, cardToken])
  @@index([userId, status])
  @@index([addressNormalized])
  @@index([cardFingerprint])
}

/// One deposit attempt. assetCode is the ledger asset credited (EUR with a real
/// provider, TEST_EUR with the sandbox); a crypto deposit's pay* columns are
/// informational chain units.
model Deposit {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clientRequestId   String?            @db.Uuid
  requestHash       String?
  method            PaymentMethodKind
  providerKey       String
  instrumentId      String?            @db.Uuid
  instrument        PaymentInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            DepositStatus      @default(CREATED)
  assetCode         String
  asset             Asset              @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  requestedMinor    BigInt
  /// What the provider said it settled when the deposit went to review: the most a person may credit.
  reportedMinor     BigInt?
  creditedMinor     BigInt?
  reversedMinor     BigInt             @default(0)
  recoveredMinor    BigInt             @default(0)
  /// Credited but over a limit (or not creditable): refund-held in a REFUND withdrawal.
  excessMinor       BigInt             @default(0)
  feeMinor          BigInt?
  payAssetCode      String?
  payAmount         String?
  payNetwork        String?
  payAddress        String?
  payMemo           String?
  txHash            String?
  confirmations     Int?
  providerPaymentId String?
  providerStatus    String?
  hostedUrl         String?
  expiresAt         DateTime
  statusReason      String?
  lateSuccess       Boolean            @default(false)
  ledgerCreditTxId  String?            @unique @db.Uuid
  ledgerCredit      LedgerTransaction? @relation("DepositCreditTx", fields: [ledgerCreditTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ip                String?
  ipCountry         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  confirmedAt       DateTime?
  creditedAt        DateTime?
  closedAt          DateTime?

  reversals         DepositReversal[]
  refundWithdrawals Withdrawal[]

  @@unique([userId, clientRequestId])
  @@unique([providerKey, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// Chargebacks, provider refunds, chain reorganisations and their recoveries. Append-only.
model DepositReversal {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depositId          String              @db.Uuid
  deposit            Deposit             @relation(fields: [depositId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerKey        String
  kind               DepositReversalKind
  providerReversalId String
  recoversReversalId String?             @unique @db.Uuid
  recovers           DepositReversal?    @relation("ReversalRecovery", fields: [recoversReversalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recoveredBy        DepositReversal?    @relation("ReversalRecovery")
  amountMinor        BigInt
  userPortionMinor   BigInt
  lossMinor          BigInt
  reasonCode         String?
  eventId            String?             @db.Uuid
  event              PaymentEvent?       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledgerTxId         String              @unique @db.Uuid
  ledgerTx           LedgerTransaction   @relation("DepositReversalTx", fields: [ledgerTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt          DateTime            @default(now())

  @@unique([providerKey, kind, providerReversalId])
  @@index([depositId])
}

/// A priced withdrawal offer (at most 10 minutes). bindHash is what the
/// withdrawal StepUpGrant must be bound to; a quote is consumed once.
model WithdrawalQuote {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentId     String            @db.Uuid
  instrument       PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerKey      String
  assetCode        String
  asset            Asset             @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  amountMinor      BigInt
  feeMinor         BigInt
  receiveAssetCode String
  receiveEstimate  String?
  rate             String?
  bindHash         String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime          @default(now())

  withdrawal Withdrawal?

  @@index([userId, createdAt])
}

model Withdrawal {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// PLAYER: requested with a quote and a step-up grant. REFUND: an excess or not-creditable deposit sent back.
  kind              WithdrawalKind     @default(PLAYER)
  clientRequestId   String?            @db.Uuid
  requestHash       String?
  quoteId           String?            @unique @db.Uuid
  quote             WithdrawalQuote?   @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceDepositId   String?            @db.Uuid
  sourceDeposit     Deposit?           @relation(fields: [sourceDepositId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentId      String?            @db.Uuid
  instrument        PaymentInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerKey       String?
  status            WithdrawalStatus   @default(REQUESTED)
  assetCode         String
  asset             Asset              @relation(fields: [assetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  amountMinor       BigInt
  feeMinor          BigInt             @default(0)
  payoutAssetCode   String?
  payoutAmount      String?
  payoutRate        String?
  /// JSON array of review reason codes; may only grow after the first evaluation.
  reviewReasons     Json               @default("[]")
  approvalsRequired Int                @default(1) @db.SmallInt
  rulesVersion      String?
  sessionId         String?
  /// The consumed withdrawal StepUpGrant (required for kind PLAYER; one withdrawal per grant).
  stepUpGrantId     String?            @unique
  providerPayoutId  String?
  txHash            String?
  failureCode       String?
  failureReason     String?
  holdTxId          String?            @unique @db.Uuid
  holdTx            LedgerTransaction? @relation("WithdrawalHoldTx", fields: [holdTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releaseTxId       String?            @unique @db.Uuid
  releaseTx         LedgerTransaction? @relation("WithdrawalReleaseTx", fields: [releaseTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settleTxId        String?            @unique @db.Uuid
  settleTx          LedgerTransaction? @relation("WithdrawalSettleTx", fields: [settleTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  returnTxId        String?            @unique @db.Uuid
  returnTx          LedgerTransaction? @relation("WithdrawalReturnTx", fields: [returnTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ip                String?
  ipCountry         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  heldAt            DateTime?
  decidedAt         DateTime?
  submittedAt       DateTime?
  settledAt         DateTime?
  closedAt          DateTime?
  /// Set once by a protective step (lockdown, freeze, screening hit): this withdrawal must not leave. Its release is a separate step the dispatcher retries.
  cancelRequestedAt DateTime?
  cancelCode        String?

  dispatch PayoutDispatch?

  @@unique([userId, clientRequestId])
  @@unique([providerKey, providerPayoutId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([cancelRequestedAt])
}

/// Payout outbox. providerIdempotencyKey never changes, so a resend can never pay twice.
model PayoutDispatch {
  withdrawalId           String               @id @db.Uuid
  withdrawal             Withdrawal           @relation(fields: [withdrawalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerKey            String
  operation              PayoutOperation
  providerIdempotencyKey String               @unique
  status                 PayoutDispatchStatus @default(PENDING)
  attempts               Int                  @default(0)
  queries                Int                  @default(0)
  nextAttemptAt          DateTime             @default(now())
  leaseUntil             DateTime?
  lastAttemptAt          DateTime?
  uncertainSince         DateTime?
  providerPayoutId       String?
  lastError              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt

  attemptLog PayoutAttempt[]

  @@index([status, nextAttemptAt])
}

/// Append-only journal of every provider call a dispatch made.
model PayoutAttempt {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  withdrawalId     String               @db.Uuid
  dispatch         PayoutDispatch       @relation(fields: [withdrawalId], references: [withdrawalId], onDelete: Restrict, onUpdate: Restrict)
  seq              Int
  /// CREATE | QUERY | REFUND
  action           String
  requestSha256    String?
  httpStatus       Int?
  outcome          PayoutAttemptOutcome
  providerPayoutId String?
  errorClass       String?
  startedAt        DateTime
  finishedAt       DateTime             @default(now())

  @@unique([withdrawalId, seq])
}

/// Durable inbox of signature-verified provider events (payload redacted).
model PaymentEvent {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  providerEventId   String
  eventType         String
  objectType        PaymentObjectType
  objectRef         String?
  merchantRef       String?
  payloadSha256     String
  payload           Json
  signatureScheme   String
  signatureVerified Boolean
  sourceIp          String?
  receivedAt        DateTime             @default(now())
  processedAt       DateTime?
  outcome           PaymentEventOutcome?
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  lastError         String?

  reversals DepositReversal[]

  @@unique([provider, providerEventId])
  @@index([processedAt, nextAttemptAt])
  @@index([provider, objectRef])
}

/// Append-only audit of every human or system decision. The database refuses
/// a non-admin ADMIN actor, self-approval and a second approval by the same admin.
model PaymentReviewAction {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType       PaymentReviewSubject
  subjectId         String
  subjectUserId     String?
  subjectUser       User?                @relation("PaymentReviewSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUserId       String?
  actorUser         User?                @relation("PaymentReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// ADMIN | SYSTEM | PLAYER
  actorKind         String
  actorAccessEmail  String?
  actorStepUpMethod String?
  verb              PaymentReviewVerb
  reasonCode        String?
  note              String?
  metadata          Json                 @default("{}")
  createdAt         DateTime             @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([subjectUserId, createdAt])
}

/// Per-flow kill switches, all seeded off: DEPOSIT_CARD, DEPOSIT_CRYPTO,
/// WITHDRAW_CARD, WITHDRAW_CRYPTO, AUTO_APPROVE, PAYOUT_DISPATCH, NEW_INSTRUMENTS.
model PaymentSwitch {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  reason    String?
  updatedAt DateTime @default(now()) @updatedAt
}

model ReconciliationRun {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// LEDGER | PAYMENTS | PROVIDER | CUSTODY
  kind       String
  scopeDate  DateTime?            @db.Date
  status     ReconciliationStatus @default(RUNNING)
  cursor     String?
  summary    Json                 @default("{}")
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  issues ReconciliationIssue[]
}

model ReconciliationIssue {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String                    @db.Uuid
  run         ReconciliationRun         @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code        String
  /// INFO | WARN | CRITICAL
  severity    String
  subjectType String?
  subjectId   String
  details     Json                      @default("{}")
  status      ReconciliationIssueStatus @default(OPEN)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime                  @default(now())

  @@unique([runId, code, subjectId])
}

/// Durable notification outbox (INTEGRATION.md override 10): inserted in the
/// transaction of the change it reports, drained by the payments Worker
/// through apps/edge/src/mail. No address is stored (User.email is read at
/// send time); payload is the template's data only, never a secret.
model EmailOutbox {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// deposit-credited, withdrawal-requested, withdrawal-paid, withdrawal-failed, destination-added, chargeback, refund-held, ...
  template      String
  /// The settlement asset of the Worker that wrote it (EUR or TEST_EUR): only that Worker sends it.
  scope         String
  payload       Json              @default("{}")
  /// Idempotency of the notification, e.g. "deposit-credited:<depositId>".
  dedupeKey     String            @unique
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  leaseUntil    DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
