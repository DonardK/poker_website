{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "poker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Not public. poker-web reaches this Worker through the API service binding.
  "workers_dev": false,
  // Supabase project tgfudufxslhrxbdxcnyl is eu-west-1. Paid/other regions: change this and TABLE_DO_LOCATION_HINT together.
  "placement": { "region": "aws:eu-west-1" },
  "vars": {
    // DEPLOY: replace <subdomain> with the account workers.dev subdomain.
    // Must be the web Worker origin (https://poker-web.<subdomain>.workers.dev).
    "CLIENT_ORIGIN": "https://poker-web.<subdomain>.workers.dev",
    "TERMS_VERSION": "2026-10-01",
    "JWT_ACCESS_TTL": "15m",
    "JWT_REFRESH_TTL": "7d",
    "SESSION_IDLE_TTL": "7d",
    "SESSION_ABSOLUTE_TTL": "30d",
    "DEFAULT_STARTING_BANKROLL": "10000",
    "TURN_TIME_BANK_MS": "20000",
    "TIME_BANK_INITIAL_MS": "30000",
    "TIME_BANK_MAX_MS": "60000",
    "TIME_BANK_REFILL_MS": "5000",
    "TIME_BANK_REFILL_EVERY_HANDS": "10",
    "ENABLE_LEGACY_BOTS": "false",
    // Free plan: 10000. Paid plan: 600000. Hard cap on stored hashes is 1000000.
    "PASSWORD_PBKDF2_ITERATIONS": "10000",
    "ENABLE_LEGACY_BCRYPT": "false",
    // Demo: skip Access JWT when CF_ACCESS_* are unset. Role === ADMIN still required.
    // Set to "true" for the strict https check.
    "ADMIN_REQUIRE_CF_ACCESS": "false",
    "TURNSTILE_SITE_KEY": "",
    "TABLE_DO_LOCATION_HINT": "weur",
    // Cloudflare Access for /api/admin. Team domain is the subdomain only.
    // With ADMIN_REQUIRE_CF_ACCESS=false, both empty skips the JWT (no 500).
    "CF_ACCESS_AUD": "",
    "CF_ACCESS_TEAM_DOMAIN": ""
  },
  // Secrets are not vars. Set them with `wrangler secret put` or .dev.vars:
  // JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, WS_TICKET_SECRET,
  // GAME_ENCRYPTION_KEYS, GAME_ENCRYPTION_ACTIVE_KEY_ID, TURNSTILE_SECRET_KEY.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<HYPERDRIVE_ID_CACHE_DISABLED>",
      // Local only. Not a real password. `.dev.vars` overrides this with the
      // Docker poker_app URL (127.0.0.1). The demo Hyperdrive uses the Supabase
      // runtime login with caching disabled. Never put that URL in this file.
      "localConnectionString": "postgresql://poker_app:replace-with-local-password@127.0.0.1:5432/poker"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableActor" },
      { "name": "LOBBY", "class_name": "LobbyActor" },
      { "name": "USER_SESSIONS", "class_name": "UserSessions" }
    ]
  },
  "exports": {
    "TableActor": { "type": "durable-object", "storage": "sqlite" },
    "LobbyActor": { "type": "durable-object", "storage": "sqlite" },
    "UserSessions": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    { "name": "RL_GENERAL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_CREDENTIALS", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_REFRESH", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WS", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
  ],
  "env": {
    "preview": {
      "name": "poker-api-preview",
      "workers_dev": false,
      "routes": [],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<PREVIEW_HYPERDRIVE_ID_CACHE_DISABLED>", "localConnectionString": "postgresql://poker_app:replace-with-local-password@127.0.0.1:5432/poker" }],
      "vars": { "CLIENT_ORIGIN": "https://poker-web-preview.<subdomain>.workers.dev" }
    }
  }
}
