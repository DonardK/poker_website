# Copy to apps/edge/.dev.vars (gitignored). Leave secrets empty in this example.
# Never put the repo-root .env, a Supabase URL, or a Neon production URL here.
# wrangler dev loads this file. Vitest does not, except the Hyperdrive URL when present.
#
# Names match apps/edge/src/env.ts. Vars also have placeholders in wrangler.jsonc.
# A value here overrides the Wrangler var for local dev only.

# --- secrets (wrangler secret put in production; never commit values) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
WS_TICKET_SECRET=
GAME_ENCRYPTION_KEYS=
GAME_ENCRYPTION_ACTIVE_KEY_ID=
TURNSTILE_SECRET_KEY=
# Account security (optional; TOTP, passkeys, MFA sign-in and money step-up stay off
# without them). All three or none. AUTH_HMAC_SECRET: openssl rand -base64 48.
# AUTH_ENCRYPTION_KEYS: a1:<openssl rand -hex 32>, never a game key.
AUTH_HMAC_SECRET=
AUTH_ENCRYPTION_KEYS=
AUTH_ENCRYPTION_ACTIVE_KEY_ID=
# Blank = no email delivery (an http CLIENT_ORIGIN logs the link instead). Needs MAIL_FROM.
RESEND_API_KEY=

# --- vars (wrangler.jsonc). Uncomment to override locally. ---
# CLIENT_ORIGIN=http://127.0.0.1:3000
# Passkeys need a host name, not an IP address: use this one to test them locally.
# CLIENT_ORIGIN=http://localhost:3000
# TERMS_VERSION=2026-10-19
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# SESSION_IDLE_TTL=14d
# SESSION_ABSOLUTE_TTL=30d
# DEFAULT_STARTING_BANKROLL=10000
# TURN_TIME_BANK_MS=20000
# TIME_BANK_INITIAL_MS=30000
# TIME_BANK_MAX_MS=60000
# TIME_BANK_REFILL_MS=5000
# TIME_BANK_REFILL_EVERY_HANDS=10
# ENABLE_LEGACY_BOTS=false
# Free plan. Paid plan: 600000. Stored hashes above 1000000 are refused.
# PASSWORD_PBKDF2_ITERATIONS=10000
# ENABLE_LEGACY_BCRYPT=false
# false: skip the Access JWT when CF_ACCESS_* are unset. User.role === ADMIN still required.
# ADMIN_REQUIRE_CF_ACCESS=false
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TABLE_DO_LOCATION_HINT=weur
# Cloudflare Access. With ADMIN_REQUIRE_CF_ACCESS=false, both empty skips the JWT
# even when CLIENT_ORIGIN is https (the workers.dev demo). true restores the
# strict check: an https origin then requires both.
# CF_ACCESS_AUD=
# CF_ACCESS_TEAM_DOMAIN=
# Account security vars. Blank WEBAUTHN_RP_ID = the CLIENT_ORIGIN host.
# WEBAUTHN_RP_ID=
# WEBAUTHN_RP_NAME=Hold'em Live
# WEBAUTHN_EXTRA_ORIGINS=
# TOTP_ISSUER=Hold'em Live
# Required with RESEND_API_KEY, on a domain verified in Resend (tracking off).
# MAIL_FROM=Hold'em Live <security@example.com>
# MAIL_REPLY_TO=
# PASSWORD_BREACH_CHECK=true
# SECURITY_HOLD_HOURS=24
# ADMIN_REQUIRE_PASSKEY=false

# Local Docker Postgres only. Host must be 127.0.0.1. User is poker_app.
# Password is the local ALTER ROLE password, not a committed secret.
# Example shape, do not commit a real password:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://poker_app:PASSWORD@127.0.0.1:5432/poker
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
