# Copy to apps/web/.env.local (gitignored). `next dev` and `next build` inline
# every NEXT_PUBLIC_* name from here. OpenNext preview/deploy run `next build`,
# so the key and origins below have to be set for that build, not only in
# wrangler.jsonc or .dev.vars.
#
# workers.dev demo and `next dev` against wrangler: leave the API and socket
# URLs empty. The browser uses window.location.origin. next dev proxies
# /api and /ws to wrangler (127.0.0.1:8787, or POKER_EDGE_ORIGIN).
# Legacy `npm run dev` (apps/server on :4000) — uncomment both:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Unset or blank: the sign-in, sign-up and password-reset forms render no Turnstile widget and do not
# send turnstileToken. Local widget (always passes, not a secret):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side (read at request time by the middleware, not inlined). "1": a
# signed-out visit to a protected page is redirected to /login before it
# renders, using the poker_session_hint cookie the API sets with the refresh
# cookie. "0" or unset: the client gate alone redirects (always correct, one
# round trip slower). Only a fast path: never an authenticator.
AUTH_HINT_REDIRECT=0
