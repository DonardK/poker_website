# Copy to apps/web/.env.local (gitignored). `next dev` and `next build` inline
# every NEXT_PUBLIC_* name from here. OpenNext preview/deploy run `next build`,
# so the key and origins below have to be set for that build, not only in
# wrangler.jsonc or .dev.vars.
#
# Same-origin production: set API and socket URLs to the public site origin
# (https://example.com). next dev proxies /api and /ws to wrangler (127.0.0.1:8787).
# Point both public URLs at the Next origin so cookies stay same-origin:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
#   NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3000
# The Node game server on :4000 is the legacy apps/server path.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Unset or blank: the login/guest UI renders no Turnstile widget and does not
# send turnstileToken. Local widget (always passes, not a secret):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
