# Copy to apps/web/.dev.vars (gitignored). Wrangler reads that file for
# `opennextjs-cloudflare preview`. Do not put TURNSTILE_SECRET_KEY here:
# siteverify runs on the API Worker (apps/edge).
#
# NEXT_PUBLIC_* is inlined into the browser bundle when `next build` runs
# (OpenNext calls that script). Set the same names in the build environment
# or in apps/web/.env.local. A value that exists only in .dev.vars is visible
# to server code at preview time; it does not rewrite an already-built client.
# Production and preview need separate builds if these origins differ.
# workers.dev demo: leave API and socket URLs empty. The client uses the
# page origin, so the account subdomain is not baked into the bundle.
# 'self' in the CSP covers that host, including wss.
#
# Legacy `npm run dev` (apps/server on :4000):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
#
# next dev against wrangler can also leave these empty. The Next rewrites
# proxy /api and /ws to 127.0.0.1:8787.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Cloudflare's published dummy site key (always passes). Not a secret.
# Pair the API Worker with secret 1x0000000000000000000000000000000AA.
# Always-block pair, if you need a refusal: site 2x00000000000000000000AB
# and secret 2x0000000000000000000000000000000AA.
# Leave this blank to render no widget and send no turnstileToken.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# "1": the middleware redirects signed-out visits to protected pages to /login
# before rendering (poker_session_hint cookie from the API). "0": the client
# gate alone does it. Read at request time.
AUTH_HINT_REDIRECT=0
