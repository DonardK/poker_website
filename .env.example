# --- Database (docker compose default) ---
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker?schema=public

# --- Redis (leave empty to run sockets/state in-process for local play) ---
REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Game defaults ---
DEFAULT_STARTING_BANKROLL=10000
TURN_TIME_BANK_MS=15000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
