# Game-server login: poker_app (inherits poker_server, NOSUPERUSER, NOBYPASSRLS).
# Migrations use DIRECT_URL, the administrator. Never give that URL to the API
# or to Cloudflare Hyperdrive. Password steps: apps/server/prisma/RUNTIME_ROLE.md
# Local docker (127.0.0.1 only). Replace both passwords; do not commit real ones.
DATABASE_URL=postgresql://poker_app:replace-with-poker-app-password@127.0.0.1:5432/poker?schema=public
DIRECT_URL=postgresql://poker:replace-with-postgres-password@127.0.0.1:5432/poker?schema=public
# Neon (placeholders). Pooled host for the app, direct host for migrations.
# DATABASE_URL=postgresql://poker_app:replace-with-password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://neondb_owner:replace-with-password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Supabase, if still used: sslmode=require and sslaccept=strict, and append
# sslcert=<URL-encoded absolute path to apps/server/certs/supabase-pooler-root.pem>.
# Prefer the Session pooler (IPv4). The direct host db.<ref>.supabase.co is IPv6-only.
# Local compose passwords (POSTGRES_PASSWORD, REDIS_PASSWORD, optional
# POKER_APP_PASSWORD) belong in .env.compose, not in this file. dotenv does not
# override, so a live DATABASE_URL already set in the repo-root .env wins.

# Optional Socket.io fanout. Game state always lives in PostgreSQL.
REDIS_URL=
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# TLS. Hole cards are sent only over TLS in production, and the server refuses
# to start with NODE_ENV=production unless one of these is configured:
#  a) Direct TLS: set BOTH files (PEM certificate chain and private key). The
#     server then listens with node:https (TLS 1.2 minimum). Set both or neither.
#  b) A TLS-terminating proxy or load balancer: leave both files blank and set
#     TRUST_PROXY_HOPS to the number of trusted proxies in front of the server
#     (>= 1). The server then trusts X-Forwarded-Proto from ANY peer that
#     connects, so the application port must be reachable ONLY through the
#     proxy (bind it to a private interface or firewall it). The proxy must
#     OVERWRITE X-Forwarded-Proto (not append to a client-supplied value);
#     the first value must be "https".
# In production, plaintext HTTP requests get 426 (except GET /api/health) and
# every plaintext Socket.io request (handshake, long-polling request or
# WebSocket upgrade) is refused. Development is unaffected.
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUST_PROXY_HOPS=0

# Generate three independent secrets; never use these placeholders.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GAME_ENCRYPTION_KEY=replace-with-64-hex-characters
JWT_ACCESS_SECRET=replace-with-a-separate-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
DEFAULT_STARTING_BANKROLL=10000
TURN_TIME_BANK_MS=15000

# Only these public values belong in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
